#!/usr/bin/env python3

import sys

inp = sys.argv[1]
out = inp + "_light"

skip = False

with open(inp, "r", errors="ignore") as fin, \
     open(out, "w") as fout:

    for line in fin:

        if "onsite density matrix" in line:
            skip = True
            continue

        if skip and "EDDAV:" in line:
            skip = False
            fout.write(line)
            continue

        if not skip:
            fout.write(line)

print(f"Created {out}")
